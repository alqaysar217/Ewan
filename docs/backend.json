
{
  "entities": {
    "User": {
      "title": "مستخدم",
      "description": "بيانات المستخدمين (عملاء، تجار، مسؤولين)",
      "type": "object",
      "properties": {
        "full_name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "avatar_url": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "vendor", "admin"] },
        "is_active": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["full_name", "email", "role"]
    },
    "Vendor": {
      "title": "تاجر / مقدم خدمة",
      "description": "بيانات المتاجر والنجارين ومصممي الديكور",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "business_name": { "type": "string" },
        "slug": { "type": "string" },
        "business_type": { "type": "string", "enum": ["furniture_store", "carpenter", "interior_designer"] },
        "description": { "type": "string" },
        "logo_url": { "type": "string" },
        "cover_url": { "type": "string" },
        "city": { "type": "string" },
        "service_areas": { "type": "array", "items": { "type": "string" } },
        "approval_status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "average_rating": { "type": "number" }
      }
    },
    "Product": {
      "title": "منتج",
      "description": "الأثاث والديكورات المعروضة في المتجر",
      "type": "object",
      "properties": {
        "vendor_id": { "type": "string" },
        "category_id": { "type": "string" },
        "name_ar": { "type": "string" },
        "description_ar": { "type": "string" },
        "price": { "type": "number" },
        "compare_at_price": { "type": "number" },
        "material": { "type": "string" },
        "color": { "type": "string" },
        "dimensions": { "type": "string" },
        "room_type": { "type": "string" },
        "style": { "type": "string" },
        "stock_quantity": { "type": "number" },
        "is_featured": { "type": "boolean" },
        "approval_status": { "type": "string", "enum": ["pending", "approved", "rejected"] }
      }
    },
    "AIDesignRequest": {
      "title": "طلب تصميم ذكاء اصطناعي",
      "description": "طلبات إعادة تصميم الغرف باستخدام الذكاء الاصطناعي",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "original_image_url": { "type": "string" },
        "reference_image_url": { "type": "string" },
        "room_type": { "type": "string" },
        "selected_style": { "type": "string" },
        "budget_min": { "type": "number" },
        "budget_max": { "type": "number" },
        "status": { "type": "string", "enum": ["queued", "processing", "completed", "failed"] }
      }
    },
    "Order": {
      "title": "طلب شراء",
      "description": "طلبات شراء الأثاث من المتجر",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "total": { "type": "number" },
        "order_status": { "type": "string", "enum": ["pending", "confirmed", "preparing", "shipped", "delivered", "cancelled"] },
        "payment_status": { "type": "string", "enum": ["pending", "paid", "failed"] },
        "shipping_address": { "type": "object" }
      }
    },
    "Conversation": {
      "title": "محادثة",
      "description": "المحادثات بين العملاء والتجار",
      "type": "object",
      "properties": {
        "customer_id": { "type": "string" },
        "vendor_id": { "type": "string" },
        "last_message_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "google"]
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "ملفات المستخدمين" },
    "/vendors/{vendorId}": { "schema": "Vendor", "description": "بيانات التجار" },
    "/products/{productId}": { "schema": "Product", "description": "كتالوج المنتجات" },
    "/orders/{orderId}": { "schema": "Order", "description": "طلبات الشراء" },
    "/ai_design_requests/{requestId}": { "schema": "AIDesignRequest", "description": "طلبات تصميم الذكاء الاصطناعي" },
    "/conversations/{convId}": { "schema": "Conversation", "description": "غرف المحادثة" }
  }
}
